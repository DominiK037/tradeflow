<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.tradeflow</groupId>
        <artifactId>tradeflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ledger-service</artifactId>
    <name>TradeFlow Ledger Service</name>
    <description>
        Bounded context: Financial Wallet and Ledger.
        Owns double-entry bookkeeping, fund reservations, and wallet balance.
        Exposes a gRPC server (internal) and REST endpoints (via Gateway proxy).
        Consumes order-events from Kafka. Produces wallet-events to Kafka.
        Has NO dependency on order-service — dependency flows one way only.
    </description>

    <dependencies>

        <!-- ── Web (Servlet / MVC stack) ─────────────────────────────── -->
        <!--
            spring-boot-starter-web — provides the embedded Tomcat container,
            Spring MVC dispatcher, Jackson JSON serialisation, and REST support.
            Required because GET /api/v1/wallet/balance is routed here from Gateway.

            WHY MVC (not WebFlux) for this service:
            Ledger operations are inherently transactional and sequential.
            The blocking JDBC model maps cleanly to the MVC thread-per-request
            model. WebFlux with blocking JDBC would require explicit scheduling
            on a bounded thread pool — more complexity, no benefit here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Data ──────────────────────────────────────────────────── -->
        <!--
            spring-boot-starter-data-jdbc — provides JdbcTemplate, NamedParameterJdbcTemplate,
            and Spring Data JDBC repositories.

            WHY Spring Data JDBC over JPA/Hibernate:
            The double-entry ledger requires precise, auditable SQL. Hibernate's
            lazy loading, dirty checking, and first-level cache introduce
            non-deterministic behaviour in financial transaction boundaries.
            Spring Data JDBC is explicit — every query is a query you wrote.
            No N+1 problems hiding behind @OneToMany.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!--
            mysql-connector-j — JDBC driver for MySQL 8.x.
            Provided by Spring Boot version management — no explicit version needed.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── gRPC Server ───────────────────────────────────────────── -->
        <!--
            grpc-server-spring-boot-starter — auto-configures a Netty-based gRPC
            server on a separate port (default 9090). Provides @GrpcService,
            @GrpcGlobalServerInterceptor, and @GrpcAdvice annotations.

            WHY the dedicated server starter (not the combined starter):
            ledger-service is a gRPC server only — it does not call other services
            via gRPC. Using the server-only starter avoids pulling in gRPC client
            connection pool infrastructure that would never be used.
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
        </dependency>

        <!--
            tradeflow-proto — provides the generated stub classes that
            LedgerGrpcService will implement. Must be built before this module.
        -->
        <dependency>
            <groupId>io.tradeflow</groupId>
            <artifactId>tradeflow-proto</artifactId>
        </dependency>

        <!-- ── Security + JWT ────────────────────────────────────────── -->
        <!--
            spring-boot-starter-security — provides SecurityFilterChain,
            @PreAuthorize, SecurityContextHolder, and the Spring Security
            filter chain that we configure for RBAC on REST endpoints.

            Also used indirectly by the gRPC JWT ServerInterceptor — we
            manually populate the SecurityContext with the JWT claims so
            that @PreAuthorize works on gRPC service methods too.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- jjwt-api — the JWT builder and parser interfaces -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- jjwt-impl — runtime implementation of the JWT algorithms -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <!-- jjwt-jackson — Jackson-based JSON parsing for JWT payload -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- ── Messaging (Kafka) ──────────────────────────────────────── -->
        <!--
            spring-kafka — provides @KafkaListener, KafkaTemplate, and
            the ConsumerFactory/ProducerFactory auto-configuration.
            Ledger service: CONSUMES order-events, PRODUCES wallet-events.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ── Observability ─────────────────────────────────────────── -->
        <!--
            spring-boot-starter-actuator — exposes /actuator/health and
            /actuator/info endpoints used by Kubernetes liveness and
            readiness probes. Without this, K8s cannot tell if the pod
            is ready to receive traffic.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── Validation ─────────────────────────────────────────────── -->
        <!--
            spring-boot-starter-validation — provides @Valid, @NotNull,
            @NotBlank etc. for request body validation on REST controllers.
            Prevents invalid input from reaching business logic.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Testing ────────────────────────────────────────────────── -->
        <!--
            spring-boot-testcontainers — provides @ServiceConnection which
            auto-wires Testcontainers container properties into Spring's
            DataSource and Kafka auto-configuration. No manual port wiring.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- testcontainers JUnit 5 extension — @Container lifecycle management -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MySQL container — spins up a real MySQL 8 for integration tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kafka container — spins up a real Kafka broker for integration tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-kafka-test — EmbeddedKafkaBroker for lightweight unit tests -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-security-test — SecurityMockMvcRequestPostProcessors, etc. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Activating spring-boot-maven-plugin here packages this module
                as an executable JAR with an embedded Tomcat.
                The proto module does NOT declare this plugin — it stays as
                a plain library JAR.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Jacoco coverage gate — activated per service module -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
